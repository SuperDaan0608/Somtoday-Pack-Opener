{
  "manifest_version": 3,
  "name": "Somtoday Pack Opener",
  "short_name": "Pack Opener",
  "version": "0.1.0",
  "version_name": "0.1 bèta",
  "description": "Open je cijfer als een FIFA-pakket: tunnel, walkout en een eigen kaart voor elk vak.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pakket openen",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Open de Pack Opener"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["fonts/*.woff2"],
      "matches": ["<all_urls>"]
    }
  ]
}
