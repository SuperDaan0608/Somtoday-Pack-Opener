{
  "manifest_version": 3,
  "name": "Somtoday Pack Opener",
  "short_name": "Pack Opener",
  "version": "2.2.1",
  "version_name": "2.2.1",
  "description": "Open je Somtoday-cijfers als een FIFA-pakket: tunnel, walkout en een eigen kaart voor elk vak.",
  "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage"],
  "content_scripts": [
    {
      "matches": ["https://leerling.somtoday.nl/*"],
      "css": ["content.css", "rooster.css", "thema.css"],
      "js": ["thema.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://leerling.somtoday.nl/*"],
      "js": ["motor/data.js", "motor/audio.js", "motor/shaders.js", "motor/gl.js", "motor/art.js", "motor/openingen/kluis.js", "motor/openingen/plinko.js", "motor/openingen/ster.js", "motor/openingen/raket.js", "motor/openingen/schiet.js", "motor/openingen/dans.js", "motor/zeldzaam.js", "motor/scene.js", "motor/main.js", "gevecht.js", "prestatieslib.js", "economie.js", "content.js", "dagelijks.js", "rooster.js", "updatemelding.js"],
      "run_at": "document_idle"
    }
  ],
  "background": { "service_worker": "update.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pakket openen",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Open de Pack Opener"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["fonts/*.woff2", "sounds/*.mp3"],
      "matches": ["<all_urls>"]
    },
    {
      "resources": ["hub.html", "galerij.html", "kaart.html", "vrienden.html", "team.html", "prestaties.html", "rekenen.html", "geluiden.html", "winkel.html", "profiel.html"],
      "matches": ["https://leerling.somtoday.nl/*"]
    }
  ]
}
