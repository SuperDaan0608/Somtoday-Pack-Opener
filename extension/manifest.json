{
  "manifest_version": 3,
  "name": "Somtoday Pack Opener",
  "short_name": "Pack Opener",
  "version": "0.2.0",
  "version_name": "0.2 bèta",
  "description": "Open je Somtoday-cijfers als een FIFA-pakket: tunnel, walkout en een eigen kaart voor elk vak.",
  "permissions": ["activeTab", "scripting", "storage"],
  "content_scripts": [
    {
      "matches": ["https://leerling.somtoday.nl/*"],
      "css": ["content.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://leerling.somtoday.nl/*"],
      "js": ["pack.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pakket openen",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Open de Pack Opener"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["fonts/*.woff2", "sounds/*.mp3"],
      "matches": ["<all_urls>"]
    }
  ]
}
